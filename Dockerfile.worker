FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    build-essential \
    dbus-x11 \
    libsecret-tools \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
    && chmod 0755 /usr/local/bin/agy \
    && useradd -m -u 1000 agy \
    && mkdir -p /app /work /session /artifacts /home/agy/.gemini \
    && chown -R agy:agy /app /work /session /artifacts /home/agy

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Install third-party dependencies in a cached layer before copying source code.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes --no-emit-project --extra worker -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY --chown=agy:agy README.md ./
COPY --chown=agy:agy src ./src

RUN uv pip install --system --no-cache --no-deps .

USER 1000:1000
WORKDIR /work
CMD ["agent-tasks-worker"]
